    roleEn: 'Technical Product Manager — Video Streaming & OTT',
    summaryFr: 'Transformation et exploitation d’une plateforme MAM SaaS critique à l’échelle européenne.',
    summaryEn: 'Transformation and operation of a critical SaaS MAM platform at European scale.',
    contextFr: '1M+ actifs · 500+ utilisateurs quotidiens · 10+ marchés européens',
    contextEn: '1M+ assets · 500+ daily users · 10+ European markets',
    responsibilities: [
      {
        fr: 'Pilotage de la roadmap et traduction des objectifs métier en priorités et jalons de livraison.',
        en: 'Owned the roadmap and translated business objectives into priorities and delivery milestones.',
      },
      {
        fr: 'Discovery multi-marchés : entretiens, ateliers de besoins et études d’usage.',
        en: 'Led multi-market discovery through interviews, requirements workshops, and usability studies.',
      },
      {
        fr: 'Gestion des releases de bout en bout et coordination Dev, QA et Production.',
        en: 'Managed end-to-end releases and coordinated Development, QA, and Production.',
      },
      {
        fr: 'Amélioration de la recherche Elasticsearch et des performances de la plateforme SaaS.',
        en: 'Improved Elasticsearch search and SaaS platform performance.',
      },
      {
        fr: 'Résolution d’incidents et alignement des équipes éditoriales, opérationnelles et techniques.',
        en: 'Resolved incidents and aligned editorial, operational, and technical teams.',
      },
    ],
    tools: 'MAM SaaS · Elasticsearch · Build & Run · Roadmap · Discovery · Release management',
    outcomeFr: 'Recherche plus pertinente et chargement des résultats réduit de 40 %, avec des workflows plus fiables.',
    outcomeEn: 'More relevant search and 40% faster result loading, with more reliable workflows.',
  },
  {
    id: 'sncf',
    date: '02/2019 — 07/2019',
    company: 'SNCF Gares & Connexions',
    roleFr: 'Product Owner API',
    roleEn: 'API Product Owner',
    summaryFr: 'Produit API pour l’ingestion et la circulation de données de trafic ferroviaire.',
    summaryEn: 'API product for ingesting and distributing railway traffic data.',
    contextFr: 'APIs de données · Flux ferroviaires · Multiples parties prenantes',
    contextEn: 'Data APIs · Railway flows · Multiple stakeholders',
    responsibilities: [
      {
        fr: 'Pilotage des APIs d’ingestion de données de trafic ferroviaire.',
        en: 'Managed railway traffic data-ingestion APIs.',
      },
      {
        fr: 'Animation d’ateliers pour collecter et formaliser les besoins.',
        en: 'Facilitated workshops to gather and formalise requirements.',
      },
      {
        fr: 'Définition des contrats d’interface avec les équipes techniques et métier.',
        en: 'Defined interface contracts with engineering and business teams.',
      },
    ],
    tools: 'REST APIs · Data ingestion · Interface contracts · Stakeholder workshops',
    outcomeFr: 'Un cadre produit et des interfaces explicites pour fiabiliser les échanges de données.',
    outcomeEn: 'A clear product framework and explicit interfaces for more reliable data exchange.',
  },
  {
    id: 'renault',
    date: '07/2017 — 01/2019',
    company: 'Renault',
    roleFr: 'Product Owner',
    roleEn: 'Product Owner',
    summaryFr: 'Déploiement d’une application web de configuration automobile et migration cloud.',
    summaryEn: 'Car-configurator web application rollout and cloud migration.',
    contextFr: 'Web application · Déploiement produit · Migration AWS',
    contextEn: 'Web application · Product rollout · AWS migration',
    responsibilities: [
      {
        fr: 'Coordination du déploiement d’une Web App de configurateur automobile.',
        en: 'Coordinated the rollout of a car-configurator web application.',
      },
      {
        fr: 'Pilotage de la migration de l’application vers AWS.',
        en: 'Managed the application migration to AWS.',
      },
    ],
    tools: 'Web application · Product rollout · AWS migration',
    outcomeFr: 'Déploiement produit et transition cloud pilotés dans un environnement groupe.',
    outcomeEn: 'Product rollout and cloud transition managed within an enterprise environment.',
  },
];

const education = [
  {
    date: '09/2016',
    organisation: 'Telecom Lille',
    titleFr: 'Diplôme d’ingénieur — Télécommunications',
    titleEn: 'Engineering master’s degree — Telecommunications',
    typeFr: 'Formation initiale',
    typeEn: 'Degree',
  },
  {
    date: 'CERTIFICATE',
    organisation: 'University of California, Berkeley',
    titleFr: 'Certification en Product Management',
    titleEn: 'Product Management Certificate',
    typeFr: 'Formation continue',
    typeEn: 'Continuing education',
  },
  {
    date: 'CERTIFICATION',
    organisation: 'Scrum.org',
    titleFr: 'Professional Scrum Product Owner I',
    titleEn: 'Professional Scrum Product Owner I',
    typeFr: 'PSPO I',
    typeEn: 'PSPO I',
  },
];

const skillGroups = [
  {
    code: 'SKILL_01',
    titleFr: 'Stratégie & discovery',
    titleEn: 'Strategy & discovery',
    items: 'Product strategy · Roadmap · User research · Design Thinking · JTBD · OKRs · Stakeholder management',
    proofFr: 'Preuve : transformation Eurosport',
    proofEn: 'Evidence: Eurosport transformation',
    target: 'mission',
  },
  {
    code: 'SKILL_02',
    titleFr: 'Delivery & opérations',
    titleEn: 'Delivery & operations',
    items: 'Backlog · Build & Run · Release management · QA → Production · Incident management · KPI monitoring',
    proofFr: 'Preuve : mission et parcours',
    proofEn: 'Evidence: mission and experience',
    target: 'experience',
  },
  {
    code: 'SKILL_03',
    titleFr: 'Produit technique',
    titleEn: 'Technical product',
    items: 'REST APIs · API contracts · Elasticsearch · OpenSearch · Kafka · Microservices · SQL · Grafana',
    proofFr: 'Preuve : Eurosport + SNCF',
    proofEn: 'Evidence: Eurosport + SNCF',
    target: 'experience',
  },
  {
    code: 'SKILL_04',
    titleFr: 'IA & prototypage',
    titleEn: 'AI & prototyping',
    items: 'AI pipelines · RAG · Vector search · Python · OCR / YOLO · LLM workflows · Git',
    proofFr: 'Preuve : laboratoire personnel',
    proofEn: 'Evidence: personal lab',
    target: 'lab',
  },
];

const pageTitle = 'Aziz Ghariani — Product Manager / Product Owner';
const pageDescription = 'Product Manager / Product Owner à Paris. Produits complexes, plateformes SaaS, data, APIs et IA.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="bios-shell">
    <UtilityBar />
    <TabNavigation />

    <main class="panel-stack" id="main-panel">
      <section
        class="screen"
        id="profile-panel"
        data-panel="profile"
        data-active="true"
        role="tabpanel"
        aria-labelledby="profile-tab"
      >
        <div class="main-pane profile-pane" data-screen-label="SYSTEM PROFILE / 01">
          <div>
            <p class="eyebrow" data-fr="Profil chargé" data-en="Profile loaded">Profil chargé</p>
            <h1 class="profile-title">Aziz<br />Ghariani</h1>
            <p class="role">Product Manager / Product Owner</p>
            <p
              class="statement"
              data-fr="Je transforme des produits complexes en expériences simples, fiables et utiles. J’aligne stratégie, besoins utilisateurs et contraintes techniques pour faire avancer des produits à grande échelle."
              data-en="I transform complex products into simple, reliable, and useful experiences. I align strategy, user needs, and technical constraints to move products forward at scale."
            >
              Je transforme des produits complexes en expériences simples, fiables et utiles. J’aligne stratégie, besoins utilisateurs et contraintes techniques pour faire avancer des produits à grande échelle.<span class="cursor" aria-hidden="true"></span>
            </p>
          </div>

          <div class="actions">
            <a class="action action-primary" href="mailto:ghariani.aziz@gmail.com" data-fr="Me contacter [Entrée]" data-en="Contact me [Enter]">Me contacter [Entrée]</a>
            <a class="action" href="https://calendly.com/ghariani-aziz" target="_blank" rel="noreferrer" data-fr="Réserver un échange [F10]" data-en="Book a conversation [F10]">Réserver un échange [F10]</a>
          </div>
        </div>

        <aside class="side-pane" aria-label="Résumé du profil">
          <div class="side-title"><span data-fr="État du système" data-en="System status">État du système</span><span>READY</span></div>
          <dl class="status-list">
            <div class="status-row"><dt data-fr="Localisation" data-en="Location">Localisation</dt><dd>Paris, France</dd></div>
            <div class="status-row"><dt data-fr="Expérience" data-en="Experience">Expérience</dt><dd data-fr="7+ ans" data-en="7+ years">7+ ans</dd></div>
            <div class="status-row"><dt data-fr="Disponibilité" data-en="Availability">Disponibilité</dt><dd class="online" data-fr="Ouvert" data-en="Open">Ouvert</dd></div>
            <div class="status-row"><dt data-fr="Langues" data-en="Languages">Langues</dt><dd>FR / EN</dd></div>
            <div class="status-row"><dt data-fr="Certifications" data-en="Certifications">Certifications</dt><dd>PSPO I + Berkeley</dd></div>
          </dl>
          <div class="impact-block">
            <h2 class="impact-heading" data-fr="Impact sélectionné" data-en="Selected impact">Impact sélectionné</h2>
            <div class="impact"><strong>1M+</strong><span data-fr="actifs gérés" data-en="managed assets">actifs gérés</span></div>
            <div class="impact"><strong>500+</strong><span data-fr="utilisateurs / jour" data-en="daily users">utilisateurs / jour</span></div>
            <div class="impact impact-outcome"><strong>−40%</strong><span data-fr="chargement recherche" data-en="search loading">chargement recherche</span></div>
          </div>
        </aside>
      </section>

      <section
        class="screen"
        id="mission-panel"
        data-panel="mission"
        data-active="false"
        role="tabpanel"
        aria-labelledby="mission-tab"
      >
        <div class="main-pane" data-screen-label="MISSION FILE / 01">
          <p class="eyebrow" data-fr="Mission 01 / Étude de cas" data-en="Mission 01 / Case study">Mission 01 / Étude de cas</p>
          <h2 class="section-title" data-fr="Moderniser une plateforme critique sans interrompre les opérations." data-en="Modernising a critical platform without disrupting operations.">Moderniser une plateforme critique sans interrompre les opérations.</h2>
          <p class="section-lede" data-fr="Chez Eurosport / Warner Bros. Discovery, j’ai piloté la transformation d’un outil desktop historique en plateforme MAM SaaS utilisée dans plus de dix marchés européens." data-en="At Eurosport / Warner Bros. Discovery, I led the transformation of a legacy desktop tool into a SaaS MAM platform used across more than ten European markets.">Chez Eurosport / Warner Bros. Discovery, j’ai piloté la transformation d’un outil desktop historique en plateforme MAM SaaS utilisée dans plus de dix marchés européens.</p>

          <div class="case-content">
            <article class="case-chapter">
              <div class="chapter-label" data-fr="01 / Défi" data-en="01 / Challenge">01 / Défi</div>
              <div>
                <h3 data-fr="Faire évoluer le produit tout en protégeant les workflows quotidiens" data-en="Evolve the product while protecting daily workflows">Faire évoluer le produit tout en protégeant les workflows quotidiens</h3>
                <p data-fr="La plateforme devait couvrir l’ingest, les enregistrements, la recherche, l’édition, les métadonnées, la lecture et l’export pour 500+ utilisateurs, sans fragiliser les opérations de dix marchés." data-en="The platform had to cover ingest, recording, search, editing, metadata, playback, and export for 500+ users without weakening operations across ten markets.">La plateforme devait couvrir l’ingest, les enregistrements, la recherche, l’édition, les métadonnées, la lecture et l’export pour 500+ utilisateurs, sans fragiliser les opérations de dix marchés.</p>
              </div>
            </article>

            <article class="case-chapter">
              <div class="chapter-label" data-fr="02 / Décisions produit" data-en="02 / Product decisions">02 / Décisions produit</div>
              <ul class="case-points">
                {missionDecisions.map((item) => <li data-fr={item.fr} data-en={item.en}>{item.fr}</li>)}
              </ul>
            </article>

            <article class="case-chapter">
              <div class="chapter-label" data-fr="03 / Exécution" data-en="03 / Execution">03 / Exécution</div>
              <ul class="case-points">
                {missionExecution.map((item) => <li data-fr={item.fr} data-en={item.en}>{item.fr}</li>)}
              </ul>
            </article>

            <article class="case-chapter case-evidence">
              <div class="chapter-label" data-fr="04 / Preuves" data-en="04 / Evidence">04 / Preuves</div>
              <div>
                <div class="evidence-strip" aria-label="Résultats principaux">
                  <div><strong>1M+</strong><span data-fr="actifs" data-en="assets">actifs</span></div>
                  <div><strong>500+</strong><span data-fr="utilisateurs / jour" data-en="daily users">utilisateurs / jour</span></div>
                  <div><strong>10+</strong><span data-fr="marchés" data-en="markets">marchés</span></div>
                  <div class="evidence-outcome"><strong>−40%</strong><span data-fr="chargement recherche" data-en="search loading">chargement recherche</span></div>
                </div>
                <p data-fr="La pertinence de recherche et l’efficacité des workflows ont progressé. Les parcours d’ingest, d’enregistrement, de lecture et d’export ont gagné en fiabilité opérationnelle." data-en="Search relevance and workflow efficiency improved. Ingest, recording, playback, and export became more operationally reliable.">La pertinence de recherche et l’efficacité des workflows ont progressé. Les parcours d’ingest, d’enregistrement, de lecture et d’export ont gagné en fiabilité opérationnelle.</p>
              </div>
            </article>
          </div>
        </div>

        <aside class="side-pane" aria-label="Données de la mission">
          <div class="side-title"><span data-fr="Données mission" data-en="Mission data">Données mission</span><span>2019—NOW</span></div>
          <dl class="status-list">
            <div class="status-row"><dt data-fr="Organisation" data-en="Organisation">Organisation</dt><dd>Eurosport / WBD</dd></div>
            <div class="status-row"><dt data-fr="Rôle" data-en="Role">Rôle</dt><dd>Technical PM</dd></div>
            <div class="status-row"><dt data-fr="Produit" data-en="Product">Produit</dt><dd>Cloud SaaS MAM</dd></div>
            <div class="status-row"><dt data-fr="Marchés" data-en="Markets">Marchés</dt><dd>10+</dd></div>
          </dl>
          <div class="impact-block">
            <h2 class="impact-heading" data-fr="Échelle et impact" data-en="Scale and impact">Échelle et impact</h2>
            <div class="impact"><strong>1M+</strong><span data-fr="actifs" data-en="assets">actifs</span></div>
            <div class="impact"><strong>500+</strong><span data-fr="utilisateurs / jour" data-en="daily users">utilisateurs / jour</span></div>
            <div class="impact impact-outcome"><strong>−40%</strong><span data-fr="chargement recherche" data-en="search loading">chargement recherche</span></div>
          </div>
        </aside>
      </section>

      <section
        class="screen"
        id="lab-panel"
        data-panel="lab"
        data-active="false"
        role="tabpanel"
        aria-labelledby="lab-tab"
      >
        <div class="main-pane" data-screen-label="PERSONAL LAB / 01">
          <p class="eyebrow" data-fr="Laboratoire personnel" data-en="Personal lab">Laboratoire personnel</p>
          <h2 class="section-title" data-fr="Explorer par la construction." data-en="Exploring by building.">Explorer par la construction.</h2>
          <p class="section-lede" data-fr="Des prototypes personnels pour tester des usages concrets de l’IA, de la donnée et de l’automatisation. Ils démontrent une démarche d’apprentissage et de produit, pas des missions client." data-en="Personal prototypes testing practical uses of AI, data, and automation. They demonstrate a product-learning practice, not client engagements.">Des prototypes personnels pour tester des usages concrets de l’IA, de la donnée et de l’automatisation. Ils démontrent une démarche d’apprentissage et de produit, pas des missions client.</p>

          <div class="actions lab-actions">
            <a class="action" href="https://github.com/Erenejager?tab=repositories" target="_blank" rel="noreferrer" data-fr="Voir mes dépôts GitHub ↗" data-en="View my GitHub repositories ↗">Voir mes dépôts GitHub ↗</a>
          </div>

          <div class="lab-content">
            {labs.map((lab) => (
              <article class="lab-project">
                <span class="lab-id">{lab.id}</span>
                <h3 data-fr={lab.titleFr} data-en={lab.titleEn}>{lab.titleFr}</h3>
                <p data-fr={lab.bodyFr} data-en={lab.bodyEn}>{lab.bodyFr}</p>
              </article>
            ))}
          </div>
        </div>

        <aside class="side-pane" aria-label="Données du laboratoire">
          <div class="side-title"><span data-fr="État laboratoire" data-en="Lab status">État laboratoire</span><span>PERSONAL</span></div>
          <dl class="status-list">
            <div class="status-row"><dt data-fr="Nature" data-en="Nature">Nature</dt><dd data-fr="Projets personnels" data-en="Side projects">Projets personnels</dd></div>
            <div class="status-row"><dt data-fr="Domaines" data-en="Domains">Domaines</dt><dd>AI / Data</dd></div>
            <div class="status-row"><dt data-fr="Méthode" data-en="Method">Méthode</dt><dd>Build → Learn</dd></div>
            <div class="status-row"><dt data-fr="Prototypes" data-en="Prototypes">Prototypes</dt><dd>4</dd></div>
          </dl>
          <div class="side-note">
            <strong data-fr="● DISTINCTION EXPLICITE" data-en="● EXPLICIT DISTINCTION">● DISTINCTION EXPLICITE</strong>
            <span data-fr="Ces travaux sont présentés séparément de l’expérience professionnelle et sans métriques commerciales inventées." data-en="This work is presented separately from professional experience and without invented commercial metrics.">Ces travaux sont présentés séparément de l’expérience professionnelle et sans métriques commerciales inventées.</span>
          </div>
        </aside>
      </section>

      <section
        class="screen"
        id="experience-panel"
        data-panel="experience"
        data-active="false"
        role="tabpanel"
        aria-labelledby="experience-tab"
      >
        <div class="main-pane" data-screen-label="EXPERIENCE LOG / 01">
          <p class="eyebrow" data-fr="Parcours professionnel" data-en="Professional experience">Parcours professionnel</p>
          <h2 class="section-title" data-fr="Du besoin métier à la production." data-en="From business need to production.">Du besoin métier à la production.</h2>
          <p class="section-lede" data-fr="Plus de sept ans à faire le lien entre utilisateurs, équipes techniques et objectifs métier sur des plateformes API, média et data." data-en="More than seven years connecting users, engineering teams, and business objectives across API, media, and data platforms.">Plus de sept ans à faire le lien entre utilisateurs, équipes techniques et objectifs métier sur des plateformes API, média et data.</p>

          <div class="timeline">
            {professionalExperience.map((item, index) => (
              <button
                class="timeline-entry experience-select"
                type="button"
                data-experience-target={item.id}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <div class="timeline-date">{item.date}</div>
                <div>
                  <h3>{item.company}</h3>
                  <p class="timeline-role" data-fr={item.roleFr} data-en={item.roleEn}>{item.roleFr}</p>
                  <p data-fr={item.summaryFr} data-en={item.summaryEn}>{item.summaryFr}</p>
                </div>
                <span class="experience-open" aria-hidden="true">↗</span>
              </button>
            ))}
          </div>

          <section class="education-section" aria-labelledby="education-title">
            <div class="education-heading">
              <span class="education-index">EDU / CERT</span>
              <h3 id="education-title" data-fr="Formation & certifications" data-en="Education & certifications">Formation & certifications</h3>
            </div>
            <div class="education-grid">
              {education.map((item) => (
                <article class="education-entry">
                  <span class="education-date">{item.date}</span>
                  <h4>{item.organisation}</h4>
                  <p data-fr={item.titleFr} data-en={item.titleEn}>{item.titleFr}</p>
                  <span class="education-type" data-fr={item.typeFr} data-en={item.typeEn}>{item.typeFr}</span>
                </article>
              ))}
            </div>
          </section>
        </div>

        <aside class="side-pane experience-sidebar" aria-label="Détails de l’expérience sélectionnée">
          {professionalExperience.map((item, index) => (
            <section
              class="experience-detail"
              data-experience-detail={item.id}
              data-active={index === 0 ? 'true' : 'false'}
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <div class="side-title"><span>{item.company}</span><span>{item.date}</span></div>
              <div class="experience-context">
                <span data-fr="Contexte" data-en="Context">Contexte</span>
                <p data-fr={item.contextFr} data-en={item.contextEn}>{item.contextFr}</p>
              </div>
              <div class="experience-responsibilities">
                <h3 data-fr="Responsabilités clés" data-en="Key responsibilities">Responsabilités clés</h3>
                <ul>
                  {item.responsibilities.map((responsibility) => (
                    <li data-fr={responsibility.fr} data-en={responsibility.en}>{responsibility.fr}</li>
                  ))}
                </ul>
              </div>
              <div class="experience-meta">
                <h3 data-fr="Périmètre & outils" data-en="Scope & tools">Périmètre & outils</h3>
                <p>{item.tools}</p>
              </div>
              <div class="experience-outcome">
