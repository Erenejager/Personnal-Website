---
import BaseLayout from '../layouts/BaseLayout.astro';
import UtilityBar from '../components/UtilityBar.astro';
import TabNavigation from '../components/TabNavigation.astro';
import KeyBar from '../components/KeyBar.astro';

const missionDecisions = [
  {
    fr: 'Traiter la migration comme une transformation des workflows, pas comme un simple remplacement d’outil.',
