  {
    id: 'LAB_04 / DECISION SUPPORT',
    titleFr: 'Intelligence marché crypto',
    titleEn: 'Crypto market intelligence',
    bodyFr: 'Analyse de tendances micro et macro, comparaison avec des configurations passées et génération d’un score d’entrée.',
